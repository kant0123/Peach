#!/bin/sh
# 这份检出是日语化的本地派生：不向上游推送，也不推送任何 master。
# git 给 pre-push 的参数是 $1=远端名、$2=远端地址；标准输入每行一个待推送的引用：
#   <本地引用> <本地提交> <远端引用> <远端提交>
# 没有放行开关：确实要推，先由人在这条检出外手动处理。`--no-verify` 能绕过它，
# 所以 origin 的推送地址另外在本机配置里换成了不可用的占位值（见 docs/OPERATIONS.md）。
remote="$1"
url="$2"
case "$remote $url" in
    *peach-mitao/*|origin\ *|upstream\ *)
        echo "拒绝推送：不向上游（$remote $url）推送。" >&2
        echo "这是日语化的本地派生，只在本机使用；需要推送时由人手动处理。" >&2
        exit 1
        ;;
esac
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "refs/heads/master" ]; then
        echo "拒绝推送：不向任何远端推送 master（$local_ref -> $remote_ref）。" >&2
        exit 1
    fi
done
exit 0

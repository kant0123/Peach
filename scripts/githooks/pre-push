#!/bin/sh
# 这份检出是日语化的本地派生，只推送到自己的仓库 https://github.com/kant0123/Peach.git。
# 上游 peach-mitao 和其它任何远端一律拒绝；推到这个仓库时分支不限，main 也可以。
# git 给 pre-push 的参数是 $1=远端名、$2=远端地址。按地址判断，不看远端名。
# 没有放行开关：`--no-verify` 能绕过它，所以 origin 的推送地址另外在本机配置里换成了
# 不可用的占位值（见 docs/OPERATIONS.md）。
remote="$1"
url="$2"
case "$url" in
    https://github.com/kant0123/Peach.git|https://github.com/kant0123/Peach)
        exit 0
        ;;
esac
echo "拒绝推送：只允许推送到 https://github.com/kant0123/Peach.git（这次是 $remote $url）。" >&2
exit 1
